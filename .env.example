# Web3Forms access key — public client-side key for the contact form.
# Get yours at https://web3forms.com (free, no backend required).
# Leave unset to keep the contact form in (clearly-labelled) demo mode.
VITE_WEB3FORMS_ACCESS_KEY=

# Headline discount for the offers page (/offers): a number, e.g. 15 → "15% off".
# Falls back to 15 if unset. Restart the dev server or rebuild after changing it.
VITE_OFFER_DISCOUNT_PERCENT=15

# Offer validity for /offers, as YYYY-MM-DD. Drives the offer period and the
# "Valid until" line. Restart the dev server or rebuild after changing them.
VITE_OFFER_START_DATE=2026-06-01
VITE_OFFER_END_DATE=2026-08-31
